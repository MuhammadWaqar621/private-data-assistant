# Copy to .env and fill in. .env is gitignored - never commit it.
#
# Everything here is read from ONE file: app/core/config.py (pydantic
# Settings) reads most of it, and app/engine/* reads its own vars straight
# from os.environ so that package stays independent of the rest of the app
# (see app/engine/__init__.py). docker-compose's `env_file: .env` exports
# every variable below into the backend container either way.

# --- This app's OWN metadata database ---------------------------------------
# Holds users, chats, messages and connection records - AND, via the
# `vector` extension, the schema/example embeddings that used to live in a
# separate Qdrant service (see app/engine/vector_store.py). NOT any of the
# databases you register and query - those stay where they are.
#
# For local docker-compose, this points at the `postgres` service, whose
# image is `pgvector/pgvector` (not plain `postgres`) so the `vector`
# extension is available - see docker-compose.yml. For a Vercel deployment,
# this is the connection string Vercel Postgres gives you when you
# provision it (Storage tab -> Postgres) and link it to the project; run
# `alembic upgrade head` against it once, out-of-band, after provisioning
# (see README.md).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/private_data_assistant

# --- Frontend ----------------------------------------------------------------
# Used to build links in password-reset emails. 5173 = vite dev server,
# 4173 = the docker-compose "frontend" service.
FRONTEND_URL=http://localhost:5173
# Read by docker-compose (not the backend) as a build ARG for the frontend
# image - Vite inlines VITE_* vars at build time. The browser talks to the
# backend directly, so this must be a URL the browser itself can reach. On
# Vercel this is instead just a plain Environment Variable set on the
# FRONTEND's Vercel project (Vite still inlines it at build time) - point it
# at the backend Vercel project's URL.
VITE_API_BASE_URL=http://localhost:8000

# --- Uploaded SQLite databases (Vercel Blob) ---------------------------------
# A Vercel serverless function has no persistent writable disk, so uploaded
# .sqlite files are stored in Vercel Blob instead of the local filesystem -
# see app/engine/blob_storage.py. BLOB_READ_WRITE_TOKEN is the env var name
# Vercel itself assigns when you provision a Blob store (Storage tab ->
# Blob) and connect it to a project; it's set automatically for a linked
# Vercel project, or copy it from the dashboard for local development (the
# token works from anywhere, not just code running on Vercel).
BLOB_READ_WRITE_TOKEN=

# --- Credential encryption (REQUIRED to register any connection) ------------
# Fernet key used to encrypt the password of each database you register.
# Without it, POST /api/connections returns 503 rather than storing a
# plaintext password. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes every stored password undecryptable - those
# connections then fail on their next use and must be re-saved.
ENCRYPTION_KEY=

# --- Query execution limits (applied to every query the assistant runs) -----
# Row cap: enforced by the database itself where the query shape allows
# (LIMIT / TOP / Mongo $limit), and truncated in Python otherwise.
MAX_QUERY_ROWS=200
# Statement timeout in seconds: Postgres statement_timeout, MySQL
# MAX_EXECUTION_TIME / MariaDB max_statement_time, pymssql query timeout,
# SQLite progress-handler interrupt, Mongo maxTimeMS.
QUERY_TIMEOUT_SECONDS=15

# --- Azure OpenAI - Embeddings (ALWAYS required) -----------------------------
# Schema-RAG embeds each table's schema and every question through Azure,
# regardless of which chat provider is selected below (Groq has no
# embeddings API).
AZURE_EM_ENDPOINT=
AZURE_EM_API_KEY=
AZURE_EM_API_VERSION=
AZURE_EM_MODEL=
# Vector size the embedding deployment returns - used to size the Qdrant
# collection. Typically 1536 (text-embedding-3-small / ada-002) or 3072
# (text-embedding-3-large). Optional: defaults to 1536 in code
# (app/engine/azure_client.py).
AZURE_EM_DIMENSIONS=1536

# --- Chat provider selection --------------------------------------------------
# Which provider writes the queries and the answers: "groq" (default) or
# "azure". Embeddings above are always Azure regardless.
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq). Groq retires model ids periodically -
# if a call fails with model_not_found/model_decommissioned, update this.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Azure OpenAI - Chat (used when LLM_PROVIDER=azure)
LLM_ENDPOINT=
LLM_ENDPOINT_APIKEY=
LLM_MODEL_NAME=
# Optional - falls back to AZURE_EM_API_VERSION, then a code default.
LLM_ENDPOINT_API_VERSION=

# --- JWT ----------------------------------------------------------------------
# Required for every auth endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SMTP (forgot-password emails) --------------------------------------------
# Optional - POST /api/auth/forgot-password returns 503
# (smtp_not_configured) until all of these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
